---
import Base from '../layouts/Base.astro';
---

<Base title="Mehdi Azarmi — distributed systems & security">
  <header class="hero">
    <div class="kicker">mazarmi.org — systems &amp; security</div>
    <h1>Mehdi Azarmi<br />builds distributed systems.</h1>
    <p>
      Ph.D. Purdue. etcd discovery at scale, distributed cron,
      software-defined storage. I write about papers and production in
      equal measure.
    </p>
    <div class="icons" aria-label="profiles">
      <a href="https://github.com/mazarmi" title="GitHub" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
      </a>
      <a href="https://linkedin.com/in/mazarmi" title="LinkedIn" aria-label="LinkedIn">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14.5 0h-13C.67 0 0 .67 0 1.5v13c0 .83.67 1.5 1.5 1.5h13c.83 0 1.5-.67 1.5-1.5v-13c0-.83-.67-1.5-1.5-1.5ZM4.75 13.5H2.5V6h2.25v7.5ZM3.62 4.97a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm9.88 8.53H11.25V9.85c0-.87-.35-1.47-1.23-1.47-.67 0-1.07.45-1.25.89-.06.16-.08.38-.08.6v3.63H6.44V6h2.25v1.03c.3-.46.83-1.12 2.03-1.12 1.49 0 2.78 1.08 2.78 3.56v4.03Z" /></svg>
      </a>
      <a href="mailto:mazarmi@gmail.com" title="Email" aria-label="Email">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="2" /><path d="m2.5 5 5.5 4 5.5-4" /></svg>
      </a>
    </div>
  </header>

  <div class="term"><span class="c"># latest</span><br />$ cat projects.json<br />&#123; "discovery": "etcd cluster membership, expanded", "distcron": "distributed cron", "storage": "distributed software-defined storage" &#125;</div>

  <div class="grid">
    <a class="card" href="/code/">
      <h3>quantum/discovery</h3>
      <p>Improved and expanded the etcd discovery service to reflect latest cluster membership.</p>
      <span class="tag">go</span><span class="tag">etcd</span>
    </a>
    <a class="card" href="/code/">
      <h3>distcron</h3>
      <p>A distributed cron. Simple, fault-tolerant scheduled jobs.</p>
      <span class="tag">distributed</span><span class="tag">scheduling</span>
    </a>
    <a class="card" href="/blog/first/">
      <h3>Morning-paper style notes</h3>
      <p>First post: the systems blogs that inspired a decade of reading.</p>
      <span class="tag">blog</span>
    </a>
    <a class="card" href="/papers/">
      <h3>Publications → Scholar</h3>
      <p>SOA security, trust frameworks, malware, MANET routing.</p>
      <span class="tag">papers</span>
    </a>
  </div>
</Base>
