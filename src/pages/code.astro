---
import Base from '../layouts/Base.astro';

const projects = [
  {
    name: 'rook',
    href: 'https://github.com/rook/rook',
    blurb:
      'An open, cloud-native, universal distributed storage system. Implemented the etcd manager to elastically expand and shrink the etcd cluster based on cluster status.',
    tags: ['go', 'storage', 'etcd'],
  },
  {
    name: 'quantum/discovery',
    href: 'https://github.com/quantum/discovery',
    blurb:
      'Discovery service: improved and expanded the etcd discovery service to reflect the latest cluster membership.',
    tags: ['go', 'etcd'],
  },
  {
    name: 'mazarmi/distcron',
    href: 'https://github.com/mazarmi/distcron',
    blurb: 'A distributed cron. Simple, fault-tolerant scheduled jobs.',
    tags: ['distributed', 'scheduling'],
  },
];
---

<Base title="Code — Mehdi Azarmi" current="code">
  <main class="prose-page">
    <p class="kicker">~/code</p>
    <h1 style="font-size:30px;margin:8px 0">Code</h1>
    <div class="grid">
      {
        projects.map((p) => (
          <a class="card" href={p.href}>
            <h3>{p.name}</h3>
            <p>{p.blurb}</p>
            {p.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </a>
        ))
      }
    </div>
    <p>More on <a href="https://github.com/mazarmi">github.com/mazarmi</a>.</p>
  </main>
</Base>
