---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} — Mehdi Azarmi`} description={frontmatter.description} current="blog">
  <main class="prose-page">
    <p class="kicker">{frontmatter.date}</p>
    <h1 style="font-size:30px;margin:8px 0">{frontmatter.title}</h1>
    <slot />
  </main>
</Base>
